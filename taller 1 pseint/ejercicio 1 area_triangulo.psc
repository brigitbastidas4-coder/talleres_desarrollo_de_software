Algoritmo area_triangulo
		Definir altura Como Real
		Definir base Como Real
		Definir area Como Real
		
		Escribir "vamos a calcular el area de un triangulo"
		Escribir "por favor dijita la altura en numeros"
		Leer altura
		
		Escribir "por favor dijita la base en numeros"
		Leer base
		
		area <- (base*altura)/2
		
		Escribir "el area de un triangulo es: ", area
		
FinAlgoritmo
