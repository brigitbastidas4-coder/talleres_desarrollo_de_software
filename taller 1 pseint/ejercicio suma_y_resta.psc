Algoritmo suma_y_resta
	
	Definir suma, valor1, valor2, valor3, valor4 Como Real
	
	Escribir "vamos a sumar 4 valores y a restar el ultimo"
	
	Escribir "dijita el valor1 en numeros"
	Leer valor1
	
	Escribir "dijita el valor2 en numeros"
	Leer valor2
	
	Escribir "dijita el valor3 en numeros"
	Leer valor3
	
	Escribir "dijita el valor4 en numeros"
	Leer valor4
	
	suma = valor1+valor2+valor3+valor4-valor4
	
	Escribir "la suma total de los 4 valores menos el valor 4 es:", suma
	
FinAlgoritmo