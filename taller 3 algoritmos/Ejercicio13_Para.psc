Algoritmo Ejercicio13_Para
    Definir N, i Como Entero
    Definir factorial Como Real
    Escribir "Ingrese un entero N mayor o igual que 0:"
    Leer N
    factorial <- 1
    Para i <- 1 Hasta N Hacer
        factorial <- factorial * i
    FinPara
    Escribir N, "! = ", factorial
FinAlgoritmo