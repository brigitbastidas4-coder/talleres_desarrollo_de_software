Algoritmo leer_dos_valores_mayor_menor
	
	Definir valor1_valor2_mayor_menor Como Real
	
	Escribir "vamos a mirar dos valores diferentes y saber si es mayor o menor"
	
	Escribir "digite valor 1"
	
	Leer valor1
	
	Escribir "digite valor2"
	
	Leer valor2
	
	Si valor1 > valor2 Entonces
		
		Escribir "el mayor es:" valor1
		
		Escribir "el menor es:" valor2
		
	SiNo
		
		Escribir "el mayor es:" valor2
		
		Escribir "el menor es:" valor1
		
	FinSi
	
FinAlgoritmo